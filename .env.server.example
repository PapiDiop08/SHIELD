# AAR Telco - variables SERVEUR (ingestion SFTP / watcher). Copier en .env.server.
# Ne jamais exposer ces valeurs au front ni les committer.
SUPABASE_PROJECT_REF=<ref du projet>
SUPABASE_SECRET_KEY=<cle secrete / service_role>
SHIELD_SFTP_USER=partner_test
SHIELD_SFTP_PASSWORD=<mot de passe fort>
SHIELD_SFTP_PORT=2222
